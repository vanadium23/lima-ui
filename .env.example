MONGO_INSTALLATION=docker
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=example
LOG_ENVIRONMENT=false
LOG_REQUESTS=false
PORT=3000
NREPL_PORT=7000
DEV=true
CLIENT_ADDRESS=http://localhost:4321
SERVER_URL=http://localhost:3000
SESSION_HMAC_SECRET=your-secret-key
SMTP_HOST=localhost
SMTP_PORT=2500
SMTP_FROM=test@localhost
# Для MailSlurper логин/пароль/TLS не нужны (значения можно не задавать);
# для провайдера — SMTP_USER, SMTP_PASS и SMTP_TLS=true (STARTTLS;
# порт 465 — SMTPS). Сертификат проверяется: частный CA — через
# NODE_EXTRA_CA_CERTS.
SMTP_TLS=false
