// npx eslint . --ext .js,.jsx,.ts,.tsx,.astro --fix применить к всем файлам этих расширений
{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:astro/recommended",
    "prettier"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint", "simple-import-sort"],
  "rules": {
    "simple-import-sort/imports": [
      "error",
      {
        "groups": [
          ["^@?\\w"], // Библиотеки
          ["^~"], // Алиасы
          ["^\\.\\.(?!/?$)"], // Импорты из родительских директорий
          [
            "^\\./", // Импорты из текущей директории
            "^.+\\.css$" // CSS
          ]
        ]
      }
    ],
    "no-unused-vars": "warn", // подсветка неиспользуемых переменных
    "no-multiple-empty-lines": [
      "error",
      { "max": 1, "maxEOF": 0, "maxBOF": 0 }
    ], // одна пустая строка
    "quotes": ["error", "double"], // кавычки
    "semi": ["error", "always"], // точка с запятой
    "@typescript-eslint/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": "*",
        "next": ["interface", "type", "block-like"]
      },
      { "blankLine": "always", "prev": "import", "next": "*" },
      { "blankLine": "any", "prev": "import", "next": "import" },
      { "blankLine": "always", "prev": "*", "next": "return" }
    ]
  },
  "overrides": [
    {
      "files": ["*.astro"],
      "parser": "astro-eslint-parser",
      "parserOptions": {
        "parser": "@typescript-eslint/parser",
        "extraFileExtensions": [".astro"]
      }
    },
    {
      "files": ["*.tsx"],
      "extends": ["plugin:solid/typescript"],
      "plugins": ["@typescript-eslint", "solid"]
    }
  ]
}
