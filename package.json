{
  "name": "@lima/lima-ui",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "dev": "concurrently \"astro dev --open --host\" \"astro check --watch\"",
    "start": "node dist/server/entry.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "tsx scripts/runTests.ts",
    "test-current": "tsx scripts/runTests.ts --current --desktop --verbose",
    "test-not-heavy": "tsx scripts/runTests.ts --not-heavy --desktop --verbose",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/solid-js": "^5.1.1",
    "@floating-ui/dom": "^1.7.4",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "astro": "^5.14.0",
    "normalize.css": "^8.0.1",
    "solid-floating-ui": "^0.3.1",
    "solid-js": "^1.9.9",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^9.1.3",
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/test": "^1.55.0",
    "@types/chalk": "^2.2.4",
    "@types/commander": "^2.12.5",
    "@types/node": "^20.19.16",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "autoprefixer": "^10.4.16",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "cssnano": "^6.0.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-astro": "^0.31.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-solid": "^0.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.1.1",
    "prettier-plugin-astro": "^0.13.0",
    "prettier-plugin-gherkin": "^3.1.2",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4"
  }
}
