{
  "name": "@svernik/svernik",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "concurrently \"astro dev\" \"astro check --watch\"",
    "start": "node dist/server/entry.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" cucumber-js",
    "test-current": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" cucumber-js --tags \"@under-development\""
  },
  "dependencies": {
    "@astrojs/check": "^0.5.6",
    "@astrojs/node": "^8.2.3",
    "@astrojs/solid-js": "^4.0.1",
    "astro": "^4.4.8",
    "normalize.css": "^8.0.1",
    "solid-js": "^1.8.7",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^20.10.7",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "cssnano": "^6.0.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-astro": "^0.31.4",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-solid": "^0.13.0",
    "prettier": "^3.1.1",
    "prettier-plugin-astro": "^0.13.0",
    "stylelint-config-standard": "^34.0.0",
    "ts-node": "^10.9.2"
  }
}
