{
  "name": "@lima/lima-ui",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently \"astro dev --open --host\" \"astro check --watch\"",
    "dev:docker": "concurrently \"astro dev --host\" \"astro check --watch\"",
    "start": "node dist/server/entry.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "tsx scripts/runTests.ts",
    "test-current": "tsx scripts/runTests.ts --current --desktop --verbose",
    "test-not-heavy": "tsx scripts/runTests.ts --not-heavy --desktop --verbose",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "show-trace": "playwright show-trace"
  },
  "dependencies": {
    "@astrojs/node": "^9.1.3",
    "@astrojs/solid-js": "^5.1.1",
    "@floating-ui/dom": "^1.7.4",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "astro": "^5.14.0",
    "normalize.css": "^8.0.1",
    "solid-floating-ui": "^0.3.1",
    "solid-js": "^1.9.9",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cucumber/cucumber": "^12.2.0",
    "@eslint/compat": "^1.4.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-docs": "^9.1.8",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@types/node": "^20.19.16",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "autoprefixer": "^10.4.16",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "cssnano": "^6.0.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-storybook": "^9.1.13",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-gherkin": "^3.1.3",
    "storybook": "^9.1.8",
    "storybook-solidjs-vite": "^9.0.3",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4"
  }
}
