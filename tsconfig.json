{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.astro",
    "features/**/*.ts",
    "features/**/*.tsx",
    "scripts/**/*.ts",
    "utilities/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
