---
import { getListsAndCheckListsLimitReached } from "../../../../utilities/getListsAndCheckListsLimitReached.ts";
import AppPage from "../../../layouts/app/app.astro";
import { EditList } from "../../../widgets/editList/editList.tsx";

const { isListsLimitReached, listsRequestError } = await getListsAndCheckListsLimitReached(Astro.url);
---

<AppPage titleName="Новый список" isListsLimitReached={isListsLimitReached}>
  <EditList
    client:only="solid-js"
    slot="mainContent"
    isListsLimitReached={isListsLimitReached}
    requestError={listsRequestError}
  />
</AppPage>
