---
import AppPage from "../../layouts/app/app.astro";
import { PAGE_TITLE } from "../../../features/testIds";

const response = await fetch("http://localhost:3000/lists");
const lists: Array<{ name: string; id: string }> = await response.json();
---

<AppPage>
  <div class="headerChecklist" slot="header">
    <h1 class="headerChecklist__title" data-test-id={PAGE_TITLE}>
      Списьки списьков
    </h1>
    <div class="headerChecklist__search"></div>
  </div>
  <ul slot="mainContent">
    {
      lists.map((list) => (
        <li>
          <a href={`./${list.id}`}>{list.name}</a>
        </li>
      ))
    }
    <pre>{JSON.stringify(lists, null, 2)}</pre>
  </ul>
</AppPage>
