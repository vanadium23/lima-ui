---
import { BACKEND_URL_LISTS, BACKEND_URL_NON_EXISTING } from "../../../utilities/addresses.ts";
import AppPage from "../../layouts/app/app.astro";
import type { ListFromBackend } from "../../types/types.ts";
import { getLists } from "../../widgets/editList/services/getLists.ts";
import { Lists } from "../../widgets/lists/lists.tsx";

let lists: ListFromBackend[] = [];

let listsRequestError = false;

try {
  let backendURL = import.meta.env.SERVER_API_URL;
  let backendListsAddress = BACKEND_URL_LISTS;

  if (Astro.url.searchParams.get("error") === "true") {
    backendListsAddress = BACKEND_URL_NON_EXISTING;
  }

  lists = await getLists(backendURL, backendListsAddress);
} catch {
  listsRequestError = true;
}
---

<AppPage titleName="Мои списки">
  <Lists client:only="solid-js" defaultLists={lists} slot="mainContent" listsRequestError={listsRequestError} />
</AppPage>
