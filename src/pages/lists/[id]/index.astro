---
import AppPage from "../../../layouts/app/app.astro";
import { DEFAULT_TEST_ID, PAGE_TITLE } from "../../../../features/testIds";
import {
  Button,
  ButtonComponentType,
  ButtonSize,
  ButtonTheme,
} from "../../../components/button/button";

const response = await fetch(
  `${import.meta.env.PUBLIC_API_URL}/lists/${Astro.params.id}`,
);

type Item = {
  content: string;
};

export type List = {
  name: string;
  id: string;
  items: Item[];
};

const list: List = await response.json();
---

<AppPage>
  <div class="headerChecklist" slot="header">
    <h1 class="headerChecklist__title" data-test-id={PAGE_TITLE}>
      {list.name}
    </h1>

    <div class="headerChecklist__search"></div>
  </div>
  <ul slot="mainContent">
    <Button
      componentType={ButtonComponentType.Link}
      link={`./${list.id}/edit`}
      theme={ButtonTheme.Primary}
      size={ButtonSize.Medium}
      text="Редактировать"
      testId={DEFAULT_TEST_ID}
    />
    <Button
      componentType={ButtonComponentType.Link}
      link={`./${list.id}/print`}
      theme={ButtonTheme.Primary}
      size={ButtonSize.Medium}
      text="Печать"
      testId={DEFAULT_TEST_ID}
      openInNewTab={true}
    />
    {
      list.items.map((item) => (
        <li>
          <span>{item.content}</span>
        </li>
      ))
    }
    <!--<pre>{JSON.stringify(list, null, 2)}</pre>-->
  </ul>
</AppPage>
