---
import { LISTS } from "../../../../utilities/addresses";
import AppPage from "../../../layouts/app/app.astro";
import type { BackendList } from "../../../types";
import { EditList } from "../../../widgets/editList/editList";

import "./style.css";

const response = await fetch(
  `${import.meta.env.PUBLIC_API_URL}${LISTS}${Astro.params.id}`,
);

const list: BackendList = await response.json();
---

<AppPage titleName={list.name} >
  <EditList client:only="solid-js" slot="mainContent" defaultList={list} />
</AppPage>
