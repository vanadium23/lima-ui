---
import { BACKEND_URL_NON_EXISTING, URL_MY_LISTS } from "../../../../utilities/addresses.ts";
import { getListsAndCheckListsLimitReached } from "../../../../utilities/getListsAndCheckListsLimitReached.ts";
import AppPage from "../../../layouts/app/app.astro";
import type { ListFromBackend } from "../../../types/types.ts";
import { emptyListFromBackend } from "../../../widgets/editList/editList.store.tsx";
import { EditList } from "../../../widgets/editList/editList.tsx";

import "./style.css";

let listRequestError = false;
let list: ListFromBackend;
let errorText: string = "";

function undefinedListId() {
  throw new Error("Can't find list ID");
}

try {
  let backendURL = import.meta.env.SERVER_API_URL;
  let backendListsAddress = URL_MY_LISTS;

  if (Astro.url.searchParams.get("error") === "true") {
    errorText = "Ошибка соединения с сервером, попробуйте еще раз";
    backendListsAddress = BACKEND_URL_NON_EXISTING;
  }
  const response = await fetch(`${backendURL}${backendListsAddress}/${Astro.params.id}`);

  if (!response.ok) {
    errorText = "Список с указанным ID не найден!";
    undefinedListId();
  }

  list = await response.json();
} catch {
  listRequestError = true;
  list = emptyListFromBackend;
}

const { isListsLimitReached } = await getListsAndCheckListsLimitReached(Astro.url);
---

<AppPage titleName={list.name} list404={listRequestError} isListsLimitReached={isListsLimitReached}>
  <EditList
    client:only="solid-js"
    slot="mainContent"
    defaultList={list}
    requestError={listRequestError}
    errorText={errorText}
  />
</AppPage>
