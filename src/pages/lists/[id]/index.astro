---
import { NETWORK_ERROR } from "../../../../features/testIds";
import {
  BACKEND_NON_EXISTING,
  MY_LISTS,
} from "../../../../utilities/addresses";
import { PageError } from "../../../components/pageError/pageError";
import AppPage from "../../../layouts/app/app.astro";
import { EditList } from "../../../widgets/editList/editList";
import type { List } from "../../../widgets/editList/types";

import "./style.css";

let listRequestError = false;
let list: List;
let errorText: string = "";

function undefinedListId() {
  throw new Error("Can't find list ID");
}

try {
  let backendURL = import.meta.env.PUBLIC_API_URL;
  let backendListsAddress = MY_LISTS;

  if (Astro.url.searchParams.get("error") === "true") {
    errorText = "Ошибка соединения с сервером, попробуйте еще раз";
    backendListsAddress = BACKEND_NON_EXISTING;
  }
  const response = await fetch(
    `${backendURL}${backendListsAddress}${Astro.params.id}`,
  );

  if (!response.ok) {
    errorText = "Список с указанным ID не найден!";
    undefinedListId();
  }

  list = await response.json();
} catch (error) {
  listRequestError = true;
  list = {
    name: "",
    items: [],
    id: "",
    purpose: "",
    note: "",
  };
}
---

<AppPage titleName={list.name} list404={listRequestError}>
  {
    listRequestError ? (
      <div class="listPageError">
        <PageError testId={NETWORK_ERROR}>{errorText}</PageError>
      </div>
    ) : (
      <EditList client:only="solid-js" slot="mainContent" defaultList={list} />
    )
  }
</AppPage>
