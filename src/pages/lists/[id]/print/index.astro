---
import {
  PRINT_LIST_ERROR,
  PRINT_LIST_ITEM,
  PRINT_LIST_NOTE,
  PRINT_LIST_PURPOSE,
  PRINT_LIST_TITLE,
} from "../../../../../features/testIds.ts";
import { BACKEND_URL_NON_EXISTING, URL_MY_LISTS } from "../../../../../utilities/addresses.ts";
import { DEFAULT_TAB_TITLE, suffixTabTitle } from "../../../../../utilities/tabTitle.ts";
import { isItemFromBackend, type ListElementFromBackend, type ListFromBackend } from "../../../../types/types.ts";

import "./style.css";
import "normalize.css";

type Item = {
  content: string;
};

export type List = ListFromBackend;

const emptyList: List = {
  type: "list",
  id: "",
  name: "",
  items: [],
  purpose: "",
  note: "",
  exportedTo: [],
  hasExportedItems: false,
};

function convertItemsFromBackendForPrint(elements: ListElementFromBackend[]): Item[] {
  return elements.reduce((items, element) => {
    if (isItemFromBackend(element)) {
      items.push({ content: element.content });
    } else if (element.type === "list") {
      items.push(...convertItemsFromBackendForPrint(element.items));
    }

    return items;
  }, [] as Item[]);
}

let listRequestError = false;
const errorText = "Нет соединения с сервером, попробуйте позже";
let list: List;
const token = Astro.cookies.get("token")?.value;

try {
  let backendListsAddress = URL_MY_LISTS;

  if (Astro.url.searchParams.get("error") === "true") {
    backendListsAddress = BACKEND_URL_NON_EXISTING;
  }

  const response = await fetch(`${import.meta.env.SERVER_API_URL}${backendListsAddress}/${Astro.params.id}`, {
    headers: {
      Authorization: `Bearer ${token}`,
    },
  });

  if (!response.ok) {
    throw new Error("Request failed");
  }
  list = await response.json();
} catch {
  listRequestError = true;
  list = emptyList;
}
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="#ffffff" name="msapplication-TileColor" />
    <meta content="img/favicon/ms-icon-144x144.png" name="msapplication-TileImage" />
    <meta content="#ffffff" name="theme-color" />
    <title>{listRequestError ? DEFAULT_TAB_TITLE : suffixTabTitle(list.name)}</title>
  </head>
  <body data-print={listRequestError ? "false" : "true"}>
    {
      listRequestError ? (
        <div class="print__error" data-test-id={PRINT_LIST_ERROR}>
          {errorText}
        </div>
      ) : (
        <div class="print">
          <div class="print__header">
            <div class="print__headerInner">
              <span class="print__headerTitle" data-test-id={PRINT_LIST_TITLE}>
                {list.name}
              </span>
              {list.purpose && (
                <span class="print__headerPurpose" data-test-id={PRINT_LIST_PURPOSE}>
                  {list.purpose}
                </span>
              )}
            </div>
            <div class="print__logo">Лого</div>
          </div>
          <div class="print__mainContent">
            {list.note && (
              <div class="print__note">
                <div class="print_noteTitle">Заметка:</div>
                <div class="print_noteText" data-test-id={PRINT_LIST_NOTE}>
                  {list.note}
                </div>
              </div>
            )}
            <ul class={"print__items print__items_list"}>
              {convertItemsFromBackendForPrint(list.items).map((item, index) => (
                <li class="print__item" data-test-id={PRINT_LIST_ITEM} data-test-sub-id={index}>
                  {item.content}
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }

    <script>
      if (document.body.dataset.print === "true") {
        window.addEventListener("load", () => {
          window.print();
        });
      }
    </script>
  </body>
</html>
