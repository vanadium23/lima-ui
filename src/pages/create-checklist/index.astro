---
import AppPage from "../../layouts/app/app.astro";
import "./style.css";
import {
  BasicInput,
  InputSize,
  InputTheme,
} from "../../components/basicInput/basicInput.tsx";
import {
  Button,
  ButtonTheme,
  ButtonSize,
} from "../../components/button/button";
import { EditList } from "./widgets/editList/editList.tsx";
import {
  CREATE_LIST_BUTTON,
  LIST_TITLE_INPUT,
  PAGE_TITLE,
} from "../../../features/testIds";
---

<AppPage>
  <div class="headerСhecklist" slot="header">
    <h1 class="headerСhecklist__title" data-test-id={PAGE_TITLE}>
      Создание списка
    </h1>
    <div class="headerСhecklist__search"></div>
  </div>
  <div class="createList" slot="mainContent">
    <div class="createList__title">
      <div class="createList__input">
        <BasicInput
          client:only="solid-js"
          theme={InputTheme.Secondary}
          size={InputSize.Medium}
          placeholder="Название чек-листа"
          maxLength={200}
          isRequired={true}
          name="some-name"
          testId={LIST_TITLE_INPUT}
        />
      </div>
      <Button
        client:only="solid-js"
        theme={ButtonTheme.Primary}
        size={ButtonSize.Medium}
        text="Создать"
        isDisabled={true}
        testId={CREATE_LIST_BUTTON}
      />
    </div>

    <EditList client:only="solid-js" />
  </div>
</AppPage>
