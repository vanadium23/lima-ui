---
import { PAGE_NOT_FOUND } from "../../features/testIds.ts";
import { PageError, PageErrorType } from "../components/pageError/pageError.tsx";
import Page from "../layouts/page/page.astro";
---

<Page titleName="Страница не найдена">
  <PageError
    slot="mainContent"
    type={PageErrorType.NotFound}
    title="Кажется, вы забрели не в ту степь"
    testId={PAGE_NOT_FOUND}
  >
    Возможно, запрашиваемая страница была удалена, или в адресе допущена ошибка.</PageError
  >
</Page>
