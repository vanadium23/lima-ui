---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import { Tabs, TabsSize, TabsTheme } from "../../../components/tabs/tabs.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(TabsTheme);
const sizes = Object.values(TabsSize);

const demoTabs = [
  {
    tabName: "Первая",
    content: "Содержимое первой вкладки. Здесь может быть любой контент.",
  },
  {
    tabName: "Вторая",
    content: "Содержимое второй вкладки с другой информацией.",
  },
  {
    tabName: "Третья",
    content: "Содержимое третьей вкладки для полной демонстрации функционала.",
  },
  {
    tabName: "Disabled",
    content: "Содержимое disabled вкладки для полной демонстрации функционала.",
    disabled: true,
  },
];

const demoTabsWithLongTitle = [
  {
    tabName: "Первая",
    content: "Содержимое первой вкладки. Здесь может быть любой контент.",
  },
  {
    tabName: "Вторая вкладка (широкая)",
    content: "Содержимое второй вкладки с другой информацией.",
  },
  {
    tabName: "Третья",
    content: "Содержимое третьей вкладки для полной демонстрации функционала.",
  },
];
---

<StorybookPage title="Tabs">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_1Col">
          <span class="chead" />
          <span class="chead">Default</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <Tabs
                ariaLabel="Tabs"
                client:only="solid-js"
                theme={theme}
                size={size}
                tabs={demoTabs}
                testId={DEFAULT_TEST_ID}
              >
                {demoTabs}
              </Tabs>
            </>
          ))}

          <>
            <span class="rhead">{"With long title"}</span>
            <Tabs
              ariaLabel="Tabs"
              client:only="solid-js"
              theme={theme}
              size={TabsSize.Medium}
              tabs={demoTabsWithLongTitle}
              testId={DEFAULT_TEST_ID}
            >
              {demoTabs}
            </Tabs>
          </>
        </div>
      </div>
    ))
  }
</StorybookPage>
