---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import { TextButton, TextButtonSize, TextButtonTheme } from "../../../components/textButton/textButton.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(TextButtonTheme);
const sizes = Object.values(TextButtonSize);
---

<StorybookPage title="TextButton">
  <h2>Type - Button</h2>
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_3Col">
          <span class="chead" />
          <span class="chead">Default</span>
          <span class="chead">Loading</span>
          <span class="chead">Disabled</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <TextButton client:only="solid-js" theme={theme} size={size} testId={DEFAULT_TEST_ID}>
                Text
              </TextButton>
              <TextButton client:only="solid-js" theme={theme} size={size} testId={DEFAULT_TEST_ID} loading={true}>
                Text
              </TextButton>
              <TextButton client:only="solid-js" theme={theme} size={size} testId={DEFAULT_TEST_ID} disabled={true}>
                Text
              </TextButton>
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
