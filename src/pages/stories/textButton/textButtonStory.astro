---
import { DEFAULT_TEST_ID } from "../../../../features/testIds";
import { TextButtonComponentType } from "../../../components/textButton/textButton";
import { TextButton, TextButtonSize, TextButtonTheme } from "../../../components/textButton/textButton.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(TextButtonTheme);
const sizes = Object.values(TextButtonSize);
---

<StorybookPage title="TextButton">

  <h2>Type - Button</h2>
  {themes.map((theme) => (
    <div class="demoThemeWrapper">
      <h3 class="demoThemeWrapper__title">{theme}</h3>
      <div class="grid grid_3Col">
        <span class="chead" />
        <span class="chead">Default</span>
        <span class="chead">Loading</span>
        <span class="chead">Disabled</span>

        {sizes.map((size) => (
          <span class="rhead">{size}</span>

          <TextButton client:only="solid-js" componentType={TextButtonComponentType.Button} theme={theme} size={size}
                      text="Text" testId={DEFAULT_TEST_ID} />
          <TextButton client:only="solid-js" componentType={TextButtonComponentType.Button} theme={theme} size={size}
                      text="Text" testId={DEFAULT_TEST_ID}
                      isLoading={true} />
          <TextButton client:only="solid-js" componentType={TextButtonComponentType.Button} theme={theme} size={size}
                      text="Text" testId={DEFAULT_TEST_ID}
                      isDisabled={true} />
        ))}

      </div>
    </div>
  ))}

  <h2>Type - Link</h2>
  {themes.map((theme) => (
    <div class="demoThemeWrapper">
      <h3 class="demoThemeWrapper__title">{theme}</h3>
      <div class="grid grid_3Col">
        <span class="chead" />
        <span class="chead">Default</span>
        <span class="chead">Loading</span>
        <span class="chead">Disabled</span>

        {sizes.map((size) => (
          <span class="rhead">{size}</span>

          <TextButton client:only="solid-js" componentType={TextButtonComponentType.Link} theme={theme} size={size}
                      text="Text" testId={DEFAULT_TEST_ID} />
          <span>Не предусмотрено</span>
          <TextButton client:only="solid-js" componentType={TextButtonComponentType.Link} theme={theme} size={size}
                      text="Text" testId={DEFAULT_TEST_ID}
                      isDisabled={true} />
        ))}

      </div>
    </div>
  ))}

</StorybookPage>
