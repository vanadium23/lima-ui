---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import { IconName } from "../../../components/icon/types.ts";
import { MenuItem, MenuItemSize, MenuItemTheme } from "../../../components/menuItem/menuItem.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(MenuItemTheme);
const sizes = Object.values(MenuItemSize);
---

<StorybookPage title="MenuItem">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_2Col">
          <span class="chead" />
          <span class="chead">Default</span>
          <span class="chead">Disabled</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <MenuItem client:only="solid-js" icon={IconName.Trash} theme={theme} size={size} testId={DEFAULT_TEST_ID}>
                Text
              </MenuItem>
              <MenuItem
                client:only="solid-js"
                icon={IconName.Trash}
                theme={theme}
                size={size}
                testId={DEFAULT_TEST_ID}
                disabled={true}
              >
                Text
              </MenuItem>
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
