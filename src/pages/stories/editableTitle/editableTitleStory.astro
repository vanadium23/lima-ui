---
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";
import {
  EditableTitle,
  EditableTitleTheme,
  EditableTitleSize,
} from "../../../components/editableTitle/editableTitle.tsx";
import { DEFAULT_TEST_ID } from "../../../../features/testIds";
import { LIST_TITLE_INPUT_LIMIT } from "../../../../configuration";

const themes = Object.values(EditableTitleTheme);
const sizes = Object.values(EditableTitleSize);
---

<StorybookPage title="Editable Title">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 style="font-size: 24px; margin-bottom: 10px; text-transform: capitalize;">
          {theme}
        </h3>
        <div class="grid grid_4Col">
          <span class="chead" />
          <span class="chead">Default</span>
          <span class="chead">Error</span>
          <span class="chead">Disabled</span>
          <span class="chead">Disabled Typed</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>

              <EditableTitle
                client:only="solid-js"
                theme={theme}
                size={size}
                maxLength={LIST_TITLE_INPUT_LIMIT}
                isRequired={true}
                name="Some-text"
                testId={DEFAULT_TEST_ID}
              />
              <EditableTitle
                client:only="solid-js"
                theme={theme}
                size={size}
                isError={true}
                maxLength={LIST_TITLE_INPUT_LIMIT}
                name="Some-text"
                isRequired={true}
                testId={DEFAULT_TEST_ID}
              />
              <EditableTitle
                client:only="solid-js"
                theme={theme}
                size={size}
                maxLength={LIST_TITLE_INPUT_LIMIT}
                name="Some-text"
                isRequired={true}
                testId={DEFAULT_TEST_ID}
                isDisabled={true}
              />
              <EditableTitle
                client:only="solid-js"
                theme={theme}
                size={size}
                maxLength={LIST_TITLE_INPUT_LIMIT}
                name="Some-text"
                isRequired={true}
                defaultValue={"Text"}
                testId={DEFAULT_TEST_ID}
                isDisabled={true}
              />
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
