---
import { PasteContent } from "../../../../components/pasteContent/pasteContent.tsx";
import StorybookPage from "../../../../layouts/storybook/storybookPage.astro";
import {
  MarketingAccordionQA,
  MarketingAccordionQATheme,
} from "../../../../marketing/marketingAccordionQA/marketingAccordionQA.tsx";

const themes = Object.values(MarketingAccordionQATheme);
---

<StorybookPage title="MarketingAccordionQA">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_1Col">
          <span class="chead" />
          <span class="chead">Default</span>
          <span class="chead" />
          <MarketingAccordionQA client:only="solid-js" theme={theme} title="Гармонь">
            <PasteContent />
          </MarketingAccordionQA>
        </div>
      </div>
    ))
  }
</StorybookPage>
