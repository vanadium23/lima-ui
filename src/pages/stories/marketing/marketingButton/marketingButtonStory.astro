---
import StorybookPage from "../../../../layouts/storybook/storybookPage.astro";
import {
  MarketingButton,
  MarketingButtonSize,
  MarketingButtonTheme,
} from "../../../../marketing/marketingButton/marketingButton.tsx";

const themes = Object.values(MarketingButtonTheme);
const sizes = Object.values(MarketingButtonSize);
---

<StorybookPage title="MarketingButton">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_1Col">
          <span class="chead" />
          <span class="chead">Default</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <MarketingButton client:only="solid-js" theme={theme} size={size}>
                Text
              </MarketingButton>
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
