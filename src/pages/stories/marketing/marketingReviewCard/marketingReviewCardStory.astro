---
import { PasteContent } from "../../../../components/pasteContent/pasteContent.tsx";
import StorybookPage from "../../../../layouts/storybook/storybookPage.astro";
import {
  MarketingReviewCard,
  MarketingReviewCardSize,
  MarketingReviewCardTheme,
} from "../../../../marketing/marketingReviewCard/marketingReviewCard.tsx";

const themes = Object.values(MarketingReviewCardTheme);
const sizes = Object.values(MarketingReviewCardSize);
---

<StorybookPage title="Marketing ReviewCard">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_1Col">
          <span class="chead" />
          <span class="chead">Default</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <MarketingReviewCard theme={theme} size={size} thumbnail={PasteContent()}>
                <PasteContent />
              </MarketingReviewCard>
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
