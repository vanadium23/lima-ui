---
import StorybookPage from "../../../../layouts/storybook/storybookPage.astro";
import {
  MarketingNavItem,
  MarketingNavItemSize,
  MarketingNavItemTheme,
} from "../../../../marketing/marketingNavItem/marketingNavItem.tsx";

const themes = Object.values(MarketingNavItemTheme);
const sizes = Object.values(MarketingNavItemSize);
---

<StorybookPage title="Marketing NavItem">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_1Col">
          <span class="chead" />
          <span class="chead">Default</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <MarketingNavItem href="https://ya.ru" theme={theme} size={size}>
                Text
              </MarketingNavItem>
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
