---
import { UserBadge, UserBadgeSize, UserBadgeTheme } from "../../../components/userBadge/userBadge.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(UserBadgeTheme);
const sizes = Object.values(UserBadgeSize);
---

<StorybookPage title="UserButton">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 style="font-size: 24px; margin-bottom: 10px; text-transform: capitalize;">{theme}</h3>
        <div class="grid grid_2Col">
          <span class="chead" />
          <span class="chead">Default</span>
          <span class="chead">Error</span>
          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <UserBadge size={size} tariff="professional">
                example@mail.ru
              </UserBadge>
              <UserBadge size={size} tariff="base" error={true}>
                example@mail.ru
              </UserBadge>
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>;
