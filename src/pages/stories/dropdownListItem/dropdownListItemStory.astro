---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import {
  DropdownListItem,
  DropdownListItemSize,
  DropdownListItemTheme,
} from "../../../components/dropdownListItem/dropdownListItem.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(DropdownListItemTheme);
const sizes = Object.values(DropdownListItemSize);
---

<StorybookPage title="Search Item">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_1Col">
          <span class="chead" />
          <span class="chead">Default</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <DropdownListItem
                client:only="solid-js"
                listId="https://ya.ru"
                theme={theme}
                size={size}
                testId={DEFAULT_TEST_ID}
              >
                Text
              </DropdownListItem>
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
