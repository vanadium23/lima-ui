---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import {
  ListStripeImport,
  ListStripeImportSize,
  ListStripeImportTheme,
} from "../../../components/listStripeImport/listStripeImport.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";
import type { ImportDialogList } from "../../../types/types.ts";

const themes = Object.values(ListStripeImportTheme);
const sizes = Object.values(ListStripeImportSize);

const testListData: ImportDialogList = {
  type: "list",
  id: "123134",
  name: "Пример списка для импорта",
  purpose: "Выберите элементы для импорта",
  note: "",
  exportedTo: [],
  items: [
    { type: "item", id: "123", content: "Ололо1", originalList: { id: "1", name: "Название родительского списка" } },
    { type: "item", id: "123", content: "Ололо2", originalList: { id: "1", name: "Название родительского списка" } },
    {
      type: "item",
      id: "123",
      content: "Длинный текст элемента списка для проверки отображения",
      originalList: { id: "1", name: "Название родительского списка" },
    },
    { type: "item", id: "123", content: "Ололо4", originalList: { id: "1", name: "Название родительского списка" } },
  ],
};
---

<StorybookPage title="List Stripe Import">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper demoThemeWrapper_white">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_1Col">
          <span class="chead" />
          <span class="chead">Default</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <ListStripeImport testId={DEFAULT_TEST_ID} titleHTMLName={"Title"} client:only="solid-js">
                {testListData}
              </ListStripeImport>
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
