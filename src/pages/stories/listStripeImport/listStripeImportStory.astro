---
import {
  ListStripeImport,
  ListStripeImportSize,
  ListStripeImportTheme,
} from "../../../components/listStripeImport/listStripeImport.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";
import type { EditListType } from "../../../types/types.ts";

const themes = Object.values(ListStripeImportTheme);
const sizes = Object.values(ListStripeImportSize);

const testListData: EditListType = {
  type: "list",
  id: "123134",
  name: "Пример списка для импорта",
  purpose: "Выберите элементы для импорта",
  note: "",
  exportedTo: [],
  hasExportedItems: false,
  elements: [
    {
      id: "123",
      originalList: { id: "1", name: "Название родительского списка" },
      items: [{ id: "123", content: "Ололо1" }],
      isImported: true,
      exportedTo: [],
      dragId: "123",
      auto: false,
    },
    {
      id: "456",
      originalList: { id: "1", name: "Название родительского списка" },
      items: [{ id: "456", content: "Ололо2" }],
      isImported: true,
      exportedTo: [],
      dragId: "456",
      auto: false,
    },
    {
      id: "789",
      originalList: { id: "1", name: "Название родительского списка" },
      items: [{ id: "789", content: "Длинный текст элемента списка для проверки отображения" }],
      isImported: true,
      exportedTo: [],
      dragId: "789",
      auto: false,
    },
    {
      id: "101112",
      originalList: { id: "1", name: "Название родительского списка" },
      items: [{ id: "101112", content: "Ололо4" }],
      isImported: true,
      exportedTo: [],
      dragId: "101112",
      auto: false,
    },
  ],
};
---

<StorybookPage title="List Stripe Import">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper demoThemeWrapper_white">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_1Col">
          <span class="chead" />
          <span class="chead">Default</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <ListStripeImport titleHTMLName={"Title"} client:only="solid-js" index={0}>
                {testListData}
              </ListStripeImport>
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
