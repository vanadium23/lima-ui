---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import {
  ListStripeImport,
  ListStripeImportSize,
  ListStripeImportTheme,
} from "../../../components/listStripeImport/listStripeImport.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(ListStripeImportTheme);
const sizes = Object.values(ListStripeImportSize);

const testListData = {
  title: "Пример списка для импорта",
  purpose: "Выберите элементы для импорта",
  items: [
    { text: "Ололо1" },
    { text: "Ололо2" },
    {
      text: "Длинный текст элемента списка для проверки отображения",
    },
    { text: "Ололо4" },
  ],
};
---

<StorybookPage title="List Stripe Import">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper demoThemeWrapper_white">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_1Col">
          <span class="chead" />
          <span class="chead">Default</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <ListStripeImport
                listData={testListData}
                testId={DEFAULT_TEST_ID}
                titleHTMLName={"Title"}
                client:only="solid-js"
              />
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
