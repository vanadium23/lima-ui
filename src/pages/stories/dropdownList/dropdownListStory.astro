---
import { DropdownListTheme } from "../../../components/dropdownList/dropdownList.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

import { DropdownListWrapper } from "./dropdownListWrapper.tsx";

const themes = Object.values(DropdownListTheme);
---

<StorybookPage title="Dropdown List">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_1Col">
          <span class="chead" />
          <span class="chead">Medium</span>
          <span class="rhead">Default</span>
          <DropdownListWrapper client:only="solid-js" />
        </div>
      </div>
    ))
  }
</StorybookPage>
