---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import {
  Title,
  TitlePosition,
  TitleSize,
  TitleTheme,
} from "../../../components/title/title.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(TitleTheme);
const sizes = Object.values(TitleSize);
const positions = Object.values(TitlePosition);
---

<StorybookPage title="Title">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        {positions.map((position) => (
          <>
            <h3 class="demoThemeWrapper__title">{theme}</h3>
            <span class="rhead">{position}</span>
            <div class="grid grid_1Col">
              <span class="chead" />
              <span class="chead">h1</span>

              {sizes.map((size) => (
                <>
                  <span class="rhead">{size}</span>
                  <Title
                    client:only="solid-js"
                    theme={theme}
                    size={size}
                    position={position}
                    testId={DEFAULT_TEST_ID}
                  >
                    Заголовок
                  </Title>
                </>
              ))}
            </div>
          </>
        ))}
      </div>
    ))
  }
</StorybookPage>
