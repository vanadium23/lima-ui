---
import { DEFAULT_TEST_ID } from "../../../../features/testIds";
import {
  ListStripe,
  ListStripeSize,
  ListStripeTheme,
} from "../../../components/listStripe/listStripe.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";
---

<StorybookPage title="List Stripe">
  <div class="demoThemeWrapper">
    <h3
      style="font-size: 24px; margin-bottom: 10px; text-transform: capitalize;"
    >
      Primary
    </h3>
    <div class="grid grid_1Col">
      <span class="chead"></span>
      <span class="chead">Medium</span>

      <span class="rhead">Default</span>
      <ListStripe
        client:only="solid-js"
        theme={ListStripeTheme.Primary}
        size={ListStripeSize.Medium}
        link="https://ya.ru"
        defaultListId="123"
        listTitle="Название списка не вмещается в одну строку и это не проблема"
        listPurpose="Цель списка не вмещается в одну строку, так и было задумано и это не проблема"
        editLink="https://ya.ru"
        staticOnRemoveSuccess={() => {}}
        staticOnRemoveError={() => {}}
        testId={DEFAULT_TEST_ID}
      />

      <span class="rhead">Removing</span>
      <ListStripe
        client:only="solid-js"
        theme={ListStripeTheme.Primary}
        size={ListStripeSize.Medium}
        link="https://ya.ru"
        defaultListId="123"
        listTitle="Название списка не вмещается в одну строку и это не проблема"
        listPurpose="Цель списка не вмещается в одну строку, так и было задумано и это не проблема"
        editLink="https://ya.ru"
        isRemoving={true}
        staticOnRemoveSuccess={() => {}}
        staticOnRemoveError={() => {}}
        testId={DEFAULT_TEST_ID}
      />
    </div>
  </div>
</StorybookPage>
