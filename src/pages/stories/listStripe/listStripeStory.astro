---
import StorybookPage from '../../../layouts/storybook/storybookPage.astro';
import {ListStripe, ListStripeSize, ListStripeTheme} from '../../../components/listStripe/listStripe.tsx';

const themes = Object.values(ListStripeTheme);
const sizes = Object.values(ListStripeSize);

---

<StorybookPage title="List Stripe">

    {themes.map((theme) => (
            <div class="demoThemeWrapper">
                <h3 style="font-size: 24px; margin-bottom: 10px; text-transform: capitalize;">{theme}</h3>
                <div class="grid grid_1Col">
                    <span class="chead"/>
                    <span class="chead">Default</span>

                    {sizes.map((size) => (
                            <span class="rhead">{size}</span>

                            <ListStripe client:only="solid-js"
                                        theme={theme}
                                        size={size}
                                        link="https://ya.ru"
                                        listTitle="Название списка не вмещается в одну строку и это не проблема"
                                        listPurpose="Цель списка не вмещается в одну строку, так и было задумано и это не проблема"
                                        editLink="https://ya.ru"
                            />

                    ))}

                </div>
            </div>
    ))}

</StorybookPage>