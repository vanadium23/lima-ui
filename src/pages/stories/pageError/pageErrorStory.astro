---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import {
  PageError,
  PageErrorSize,
  PageErrorTheme,
} from "../../../components/pageError/pageError.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(PageErrorTheme);
const sizes = Object.values(PageErrorSize);
---

<StorybookPage title="Accordion">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_1Col">
          <span class="chead" />
          <span class="chead">Default</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <PageError theme={theme} size={size} testId={DEFAULT_TEST_ID}>
                Ошибка, всё печально, грусти сильно...
              </PageError>
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
