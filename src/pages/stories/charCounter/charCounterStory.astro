---
import StorybookPage from '../../../layouts/storybook/storybookPage.astro';
import {CharCounter, CharCounterSize, CharCounterTheme} from '../../../components/charCounter/charCounter.tsx';

const themes = Object.values(CharCounterTheme);
const sizes = Object.values(CharCounterSize);
---

<StorybookPage title="Char Counter">

    {themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 style="font-size: 24px; margin-bottom: 10px; text-transform: capitalize;">{theme}</h3>
        <div class="grid grid_1Col">
          <span class="chead"/>
          <span class="chead">Default</span>

            {sizes.map((size) => (
              <span class="rhead">{size}</span>

              <CharCounter client:only="solid-js" theme={theme} size={size} value={100} testId="" testSubId=""/>
            ))}

        </div>
      </div>
    ))}

</StorybookPage>
