---
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";
import {
  ToolsButton,
  ToolsButtonTheme,
  ToolsButtonSize,
} from "../../../components/toolsButton/toolsButton.tsx";
import {IconName} from "../../../components/icon/icon.tsx";
import {DEFAULT_TEST_ID} from "../../../../features/testIds";

const themes = Object.values(ToolsButtonTheme);
const sizes = Object.values(ToolsButtonSize);
---

<StorybookPage title="Tools Button">

  {themes.map((theme) => (
          <div class="demoThemeWrapper">
              <h3 style="font-size: 24px; margin-bottom: 10px;">{theme}</h3>
              <div class="grid grid_3Col">
                  <span class="chead"></span>
                  <span class="chead">Default</span>
                  <span class="chead">Loading</span>
                  <span class="chead">Disabled</span>

                {sizes.map((size) => (
                        <span class="rhead">{size}</span>

                        <ToolsButton
                                client:only="solid-js"
                                text={"text"}
                                theme={theme}
                                size={size}
                                iconName={IconName.Trash}
                                testId={DEFAULT_TEST_ID}
                        />

                        <ToolsButton
                                client:only="solid-js"
                                text={"text"}
                                theme={theme}
                                size={size}
                                iconName={IconName.Trash}
                                testId={DEFAULT_TEST_ID}
                                isLoading={true}
                        />

                        <ToolsButton
                                client:only="solid-js"
                                isDisabled={true}
                                text={"text"}
                                theme={theme}
                                size={size}
                                iconName={IconName.Trash}
                                testId={DEFAULT_TEST_ID}
                        />
                ))}

              </div>
          </div>
  ))}

</StorybookPage>
