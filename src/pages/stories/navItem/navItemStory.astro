---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import { IconName } from "../../../components/icon/types.ts";
import { NavItem, NavItemSize, NavItemTheme } from "../../../components/navItem/navItem.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(NavItemTheme);
const sizes = Object.values(NavItemSize);
---

<StorybookPage title="Nav Item">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_3Col">
          <span class="chead" />
          <span class="chead">Default</span>
          <span class="chead">Current</span>
          <span class="chead">Disabled</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <NavItem
                href="https://ya.ru"
                theme={theme}
                size={size}
                icon={IconName.CircleNotch}
                testId={DEFAULT_TEST_ID}
              >
                Text
              </NavItem>
              <NavItem
                href="https://ya.ru"
                theme={theme}
                size={size}
                icon={IconName.CircleNotch}
                current={true}
                testId={DEFAULT_TEST_ID}
              >
                Text
              </NavItem>
              <NavItem
                href="https://ya.ru"
                theme={theme}
                size={size}
                icon={IconName.CircleNotch}
                disabled={true}
                testId={DEFAULT_TEST_ID}
              >
                Text
              </NavItem>
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
