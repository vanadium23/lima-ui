---
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";
import {Note, NoteSize, NoteTheme} from "../../../components/note/note.tsx";
import { DEFAULT_TEST_ID } from "../../../../features/testIds";

const themes = Object.values(NoteTheme);
const sizes = Object.values(NoteSize);
---


<StorybookPage title="Note">
    {themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_2Col">
          <span class="chead"/>
          <span class="chead">Default</span>
          <span class="chead">Disabled</span>

            {sizes.map((size) => (
              <span class="rhead">{size}</span>
              <Note client:only="solid-js" theme={theme} size={size} title="Заметка" name="" testId={DEFAULT_TEST_ID}/>
              <Note client:only="solid-js" theme={theme} size={size} title="Заметка" isDisabled={true} name="" testId={DEFAULT_TEST_ID}/>
            ))}

        </div>
      </div>

    ))}
</StorybookPage>
