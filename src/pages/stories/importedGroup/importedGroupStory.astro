---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import { ImportedGroup } from "../../../components/importedGroup/importedGroup.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";
import { type Item } from "../../../types/types.ts";

const exampleList: Item[] = [
  { id: "1", content: "Тестовый пункт 1", originalListId: "1" },
  { id: "2", content: "Тестовый пункт 2", originalListId: "1" },
  { id: "3", content: "Тестовый пункт 3", originalListId: "1" },
  { id: "4", content: "Длинный тестовый пункт для проверки отображения", originalListId: "1" },
];
---

<StorybookPage title="List Stripe Import">
  <div class="demoThemeWrapper demoThemeWrapper_white">
    <h3 class="demoThemeWrapper__title">Primary</h3>
    <div class="grid grid_1Col">
      <span class="chead"></span>
      <span class="chead">Medium</span>
      <span class="rhead">List</span>
      <ImportedGroup client:only="solid-js" testId={DEFAULT_TEST_ID} items={exampleList} id={"1"} />
      <span class="rhead">List - Disabled</span>
      <ImportedGroup client:only="solid-js" testId={DEFAULT_TEST_ID} items={exampleList} id={"1"} disabled={true} />
      <span class="rhead">Checklist</span>
      <ImportedGroup client:only="solid-js" testId={DEFAULT_TEST_ID} items={exampleList} id={"1"} isCheckable={true} />
      <span class="rhead">Checklist - Disabled</span>
      <ImportedGroup
        client:only="solid-js"
        testId={DEFAULT_TEST_ID}
        id={"1"}
        items={exampleList}
        isCheckable={true}
        disabled={true}
      />
    </div>
  </div>
</StorybookPage>
