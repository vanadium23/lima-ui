---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import { ImportedGroup } from "../../../components/importedGroup/importedGroup.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";
import { type List } from "../../../types/types.ts";

const exampleList: List = {
  note: "Lorem ipsum dolor sit amet, consectetur adipisicing elit. Aperiam debitis dolorem eos maiores minima nemo nesciunt quos reiciendis sunt veniam?",
  id: "123141",
  name: "Lorem ipsum dolor sit amet.",
  purpose: "Lorem ipsum dolor sit amet, consectetur adipisicing elit. Ipsa, reprehenderit.",
  items: [
    { id: "1", content: "Тестовый пункт 1" },
    { id: "2", content: "Тестовый пункт 2" },
    { id: "3", content: "Тестовый пункт 3" },
    { id: "4", content: "Длинный тестовый пункт для проверки отображения" },
  ],
};
---

<StorybookPage title="List Stripe Import">
  <div class="demoThemeWrapper demoThemeWrapper_white">
    <h3 class="demoThemeWrapper__title">Primary</h3>
    <div class="grid grid_1Col">
      <span class="chead"></span>
      <span class="chead">Medium</span>
      <span class="rhead">List</span>
      <ImportedGroup client:only="solid-js" testId={DEFAULT_TEST_ID}>{exampleList}</ImportedGroup>
      <span class="rhead">List - Disabled</span>
      <ImportedGroup client:only="solid-js" testId={DEFAULT_TEST_ID}>{exampleList}</ImportedGroup>
      <span class="rhead">Checklist</span>
      <ImportedGroup client:only="solid-js" testId={DEFAULT_TEST_ID} checkable={true}>{exampleList}</ImportedGroup>
      <span class="rhead">Checklist - Disabled</span>
      <ImportedGroup client:only="solid-js" testId={DEFAULT_TEST_ID} checkable={true} disabled={true}
        >{exampleList}</ImportedGroup
      >
    </div>
  </div>
</StorybookPage>
