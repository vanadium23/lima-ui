---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import { ImportedGroup } from "../../../components/importedGroup/importedGroup.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";
import { type EditListItem } from "../../../types/types.ts";

const exampleItems: EditListItem[] = [
  { type: "item", id: "1", content: "Тестовый пункт 1", originalList: { id: "", name: "" }, dragId: "", auto: false },
  { type: "item", id: "2", content: "Тестовый пункт 2", originalList: { id: "", name: "" }, dragId: "", auto: false },
  { type: "item", id: "3", content: "Тестовый пункт 3", originalList: { id: "", name: "" }, dragId: "", auto: false },
  {
    type: "item",
    id: "4",
    content: "Длинный тестовый пункт для проверки отображения",
    originalList: { id: "", name: "" },
    dragId: "",
    auto: false,
  },
];
---

<StorybookPage title="List Stripe Import">
  <div class="demoThemeWrapper demoThemeWrapper_white">
    <h3 class="demoThemeWrapper__title">Primary</h3>
    <div class="grid grid_1Col">
      <span class="chead"></span>
      <span class="chead">Medium</span>
      <span class="rhead">List</span>
      <ImportedGroup client:only="solid-js" testId={DEFAULT_TEST_ID} itemIndex={1} id={"1"} name=""
        >{exampleItems}</ImportedGroup
      >

      <span class="rhead">Checklist</span>
      <ImportedGroup
        client:only="solid-js"
        testId={DEFAULT_TEST_ID}
        itemIndex={1}
        id={"1"}
        name="Название родительского списка"
        checkable={true}>{exampleItems}</ImportedGroup
      >
    </div>
    <div>
      Дизейбледа в этой сторе нет, но он существует, потому что он смотрит на стор списка из компонента, нужно будет
      придумать что делать когда будем переносить в сторибук
    </div>
  </div>
</StorybookPage>
