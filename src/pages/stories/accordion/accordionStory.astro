---
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";
import {Accordion, AccordionSize, AccordionTheme} from "../../../components/accordion/accordion.tsx";
import {PasteContent} from "../../../components/pasteContent/pasteContent";
import {DEFAULT_TEST_ID} from "../../../../features/testIds";

const themes = Object.values(AccordionTheme);
const sizes = Object.values(AccordionSize);
---


<StorybookPage title="Accordion">
    {themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_2Col">
          <span class="chead"/>
          <span class="chead">Default</span>
          <span class="chead">Disabled</span>

            {sizes.map((size) => (
              <span class="rhead">{size}</span>
              <Accordion client:only="solid-js" theme={theme} size={size} title="Гармонь" testId={DEFAULT_TEST_ID}>
                <PasteContent/>
              </Accordion>
              <Accordion client:only="solid-js" isDisabled={true} theme={theme} size={size}
                         title="Гармонь" testId={DEFAULT_TEST_ID}>
                <PasteContent/>
              </Accordion>
            ))}

        </div>
      </div>

    ))}
</StorybookPage>
