---
import {autoUpdate, flip, hide, shift} from "@floating-ui/dom";
import {useFloating} from "solid-floating-ui";
import {createSignal} from "solid-js";

import {DEFAULT_TEST_ID, REMOVE_ITEM_BUTTON} from "../../../../features/testIds";
import {DropdownMenu, DropdownMenuSize, DropdownMenuTheme} from "../../../components/dropdownMenu/dropdownMenu";
import {IconName} from "../../../components/icon/icon";
import {MenuItem, MenuItemTheme} from "../../../components/menuItem/menuItem";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(DropdownMenuTheme);
const sizes = Object.values(DropdownMenuSize);

const [reference, setReference] = createSignal<HTMLElement>();
const [floating, setFloating] = createSignal<HTMLElement>();

const floatingPosition = useFloating(reference, floating, {
  placement: "bottom",
  whileElementsMounted: (reference, floating, update) =>
    autoUpdate(reference, floating, update, {
      animationFrame: true,
    }),
  middleware: [shift(), flip(), hide()], //TODO Подумать нужно ли Shift оставлять когда будет разработка под 320px
});
---

<StorybookPage title="DropdownMenu">

  {themes.map((theme) => (
    <div class="demoThemeWrapper">
      <h3 class="demoThemeWrapper__title">{theme}</h3>
      <div class="grid grid_1Col">
        <span class="chead"/>
        <span class="chead">Default</span>

        {sizes.map((size) => (
          <span class="rhead">{size}</span>

          <DropdownMenu client:only="solid-js" theme={theme} size={size} ref={setFloating}
                        floatingStyles={floatingPosition}
                        testId={DEFAULT_TEST_ID}>
            <MenuItem
              text={"Добавить пункт выше"}
              icon={IconName.Plus}
              testId={DEFAULT_TEST_ID}
            />
            <MenuItem
              text={"Добавить пункт ниже"}
              icon={IconName.Plus}
              testId={DEFAULT_TEST_ID}
            />
            <MenuItem
              text={"Удалить пункт"}
              theme={MenuItemTheme.Dangerous}
              icon={IconName.Trash}
              testId={REMOVE_ITEM_BUTTON}
            />
          </DropdownMenu>

        ))}

      </div>
    </div>
  ))}

</StorybookPage>
