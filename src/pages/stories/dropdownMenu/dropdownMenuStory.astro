---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import { IconName } from "../../../components/icon/types.ts";
import { MenuItemTheme } from "../../../components/menuItem/menuItem.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

import { DropdownMenuWrapper } from "./dropdownMenuWrapper.tsx";

const menuItems = () => [
  {
    text: "Добавить пункт выше",
    icon: IconName.Plus,
    handleClick: () => {},
  },
  {
    text: "Добавить пункт ниже",
    icon: IconName.Plus,
    handleClick: () => {},
  },
  {
    text: "Импортировать выше",
    icon: IconName.SortDescending,
    testId: DEFAULT_TEST_ID,
    isDisabled: true,
  },
  {
    text: "Импортировать ниже",
    icon: IconName.SortAscending,
    testId: DEFAULT_TEST_ID,
    isDisabled: true,
  },
  {
    text: "Удалить пункт",
    icon: IconName.Trash,
    handleClick: () => {},
    theme: MenuItemTheme.Dangerous,
  },
];
---

<StorybookPage title="DropdownMenu">
  {
    (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">Primary</h3>
        <div class="grid grid_1Col">
          <span class="chead" />
          <span class="chead">Default</span>

          <>
            <span class="rhead">Medium</span>
            <DropdownMenuWrapper menuItems={menuItems()} />
          </>
        </div>
      </div>
    )
  }
</StorybookPage>
