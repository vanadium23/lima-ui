---
import StorybookPage from '../../../layouts/storybook/storybookPage.astro';
import {DragHandle, DragHandleSize, DragHandleTheme} from '../../../components/dragHandle/dragHandle.tsx';
import {DEFAULT_TEST_ID} from "../../../../features/testIds";
import {IconName} from "../../../components/icon/icon";

const themes = Object.values(DragHandleTheme);
const sizes = Object.values(DragHandleSize);
---

<StorybookPage title="DragHandle">

    {themes.map((theme) => (
            <div class="demoThemeWrapper">
                <h3 class="demoThemeWrapper__title">{theme}</h3>
                <div class="grid grid_2Col">
                    <span class="chead"/>
                    <span class="chead">Default</span>
                    <span class="chead">Disabled</span>

                    {sizes.map((size) => (
                            <span class="rhead">{size}</span>

                            <DragHandle client:only="solid-js" icon={IconName.DotsSixVertical} theme={theme} size={size} testId={DEFAULT_TEST_ID}/>

                            <DragHandle client:only="solid-js" icon={IconName.DotsSixVertical} theme={theme} size={size} testId={DEFAULT_TEST_ID}
                                    isDisabled={true}/>
                    ))}

                </div>
            </div>
    ))}

</StorybookPage>