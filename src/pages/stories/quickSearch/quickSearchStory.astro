---
import { DEFAULT_TEST_ID } from "../../../../features/testIds";
import {
  QuickSearch,
  QuickSearchTheme,
} from "../../../components/quickSearch/quickSearch.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(QuickSearchTheme);

const listsExample1 = [
  {
    name: "Трололо1",
    link: "https://ya.ru",
  },
];

const listsExample2 = [
  {
    name: "Трололо1",
    link: "https://ya.ru",
  },
  {
    name: "Трололо2",
    link: "https://google.com",
  },
  {
    name: "Трололо3",
    link: "https://google.com",
  },
  {
    name: "Трололо4",
    link: "https://google.com",
  },
  {
    name: "Трололо5",
    link: "https://google.com",
  },
  {
    name: "Трололо6",
    link: "https://google.com",
  },
  {
    name: "Трололо7",
    link: "https://google.com",
  },
  {
    name: "Трололо8 джабуду-джубу азик азик ипалу пагоч азик азик, памаги адеть бикини",
    link: "https://google.com",
  },
  {
    name: "Трололо9",
    link: "https://google.com",
  },
  {
    name: "Трололо10",
    link: "https://google.com",
  },
