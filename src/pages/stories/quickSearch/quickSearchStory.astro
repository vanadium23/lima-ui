---

<StorybookPage title="Quick Search">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_1Col">
          <span class="chead" />
          <span class="chead">Medium</span>

          <span class="rhead">Default 1</span>

          <QuickSearch
            client:only="solid-js"
            testId={DEFAULT_TEST_ID}
            isLoading={false}
            lists={listsExample1}
            query="Тест"
          />

          <span class="rhead">Default 10</span>

          <QuickSearch
            client:only="solid-js"
            testId={DEFAULT_TEST_ID}
            isLoading={false}
            lists={listsExample2}
            query="Тест"
          />
          <span class="rhead">Loading</span>

          <QuickSearch
            client:only="solid-js"
            testId={DEFAULT_TEST_ID}
            isLoading={true}
            query="test"
          />

          <span class="rhead">Empty</span>

          <QuickSearch
            client:only="solid-js"
            testId={DEFAULT_TEST_ID}
            isLoading={false}
            query="test"
          />
        </div>
      </div>
    ))
  }
</StorybookPage>
