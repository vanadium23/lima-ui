---

<StorybookPage title="Quick Search">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_1Col">
          <span class="chead" />
          <span class="chead">Medium</span>

          <span class="rhead">Default 1</span>

          <QuickSearch client:only="solid-js" loading={false} query="Тест">
            {listsExample1}
          </QuickSearch>

          <span class="rhead">Default 10</span>

          <QuickSearch client:only="solid-js" loading={false} query="Тест">
            {listsExample2}
          </QuickSearch>
          <span class="rhead">Loading</span>

          <QuickSearch client:only="solid-js" loading={true} query="test" />

          <span class="rhead">Empty</span>

          <QuickSearch client:only="solid-js" loading={false} query="test" />
        </div>
      </div>
    ))
  }
</StorybookPage>
