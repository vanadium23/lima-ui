---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import { Button } from "../../../components/button/button.tsx";
import { Icon, IconSize } from "../../../components/icon/icon.tsx";
import { IconName } from "../../../components/icon/types.ts";
import { IconButton, IconButtonSize } from "../../../components/iconButton/iconButton.tsx";
import { Tooltip, TooltipPlacement, TooltipSize, TooltipTheme } from "../../../components/tooltip/tooltip.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(TooltipTheme);
const sizes = Object.values(TooltipSize);
---

<StorybookPage title="Tooltip">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_1Col">
          <span class="chead" />
          <span class="chead">Default</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <div style="display: flex; gap: 2rem; align-items: center; padding: 2rem;">
                <Tooltip
                  content="Это подсказка для кнопки"
                  theme={theme}
                  size={size}
                  testId={DEFAULT_TEST_ID}
                  client:only="solid-js"
                >
                  <Button testId={DEFAULT_TEST_ID} client:only="solid-js">
                    Наведи на меня
                  </Button>
                </Tooltip>

                <Tooltip
                  content="Подсказка для иконки + вывод сверху"
                  defaultPlacement={TooltipPlacement.Top}
                  theme={theme}
                  size={size}
                  testId={DEFAULT_TEST_ID}
                  client:only="solid-js"
                >
                  <IconButton
                    iconName={IconName.Info}
                    ariaLabel="Информация"
                    size={IconButtonSize.Medium}
                    testId={DEFAULT_TEST_ID}
                    client:only="solid-js"
                  />
                </Tooltip>

                <Tooltip
                  content="Простая не интерактивная иконка. Очень длинная подсказка которая должна переноситься на несколько строк и показывать как ведет себя компонент с большим количеством текста"
                  theme={theme}
                  size={size}
                  testId={DEFAULT_TEST_ID}
                  client:only="solid-js"
                >
                  <Icon
                    size={IconSize.Medium}
                    name={IconName.Info}
                    role={"img"}
                    ariaLabel={"Здесь должен быть дублирующий текст из тултипа"}
                  />
                </Tooltip>
              </div>
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
