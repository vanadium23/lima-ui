---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import {
  CyberInput,
  CyberInputSize,
  CyberInputTheme,
} from "../../../components/cyberInput/cyberInput.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

import { dropdownItems } from "./cyberInputMenu.ts";
import { CyberInputWrapper } from "./CyberInputWrapper.tsx";

const themes = Object.values(CyberInputTheme);
const sizes = Object.values(CyberInputSize);
---

<StorybookPage title="Cyber Input">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_5Col">
          <span class="chead" />
          <span class="chead">Default</span>
          <span class="chead">With Dropdown Menu</span>
          <span class="chead">Error</span>
          <span class="chead">Disabled</span>
          <span class="chead">Disabled Typed</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <CyberInputWrapper
                client:only="solid-js"
                size={size}
                theme={theme}
              />
              <CyberInputWrapper
                client:only="solid-js"
                size={size}
                theme={theme}
                listOfButtons={dropdownItems()}
              />
              <CyberInputWrapper
                client:only="solid-js"
                size={size}
                theme={theme}
                isError={true}
              />
              <CyberInput
                client:only="solid-js"
                theme={theme}
                size={size}
                maxLength={50}
                name="Some-text"
                isRequired={true}
                testId={DEFAULT_TEST_ID}
                placeholder="Введите текст"
                isDisabled={true}
              />
              <CyberInput
                client:only="solid-js"
                theme={theme}
                size={size}
                maxLength={50}
                name="Some-text"
                isRequired={true}
                defaultValue={"Text"}
                testId={DEFAULT_TEST_ID}
                placeholder="Введите текст"
                isDisabled={true}
              />
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
