---
import { DEFAULT_TEST_ID } from "../../../../features/testIds";
import {
  ListItem,
  ListItemSize,
  ListItemTheme,
} from "../../../components/listItem/listItem";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";
---

<StorybookPage title="List Item">
  <div class="demoThemeWrapper">
    <h3 class="demoThemeWrapper__title">Primary</h3>
    <div class="grid grid_1Col">
      <span class="chead"></span>
      <span class="chead">Medium</span>

      <span class="rhead">List</span>
      <ListItem
        client:only="solid-js"
        theme={ListItemTheme.Primary}
        size={ListItemSize.Medium}
        isCheckable={false}
        isChecked={false}
        name="Пункт"
        testId={DEFAULT_TEST_ID}
        canAddMore={false}
      />

      <span class="rhead">Checklist</span>
      <ListItem
        client:only="solid-js"
        theme={ListItemTheme.Primary}
        size={ListItemSize.Medium}
        isCheckable={true}
        isChecked={false}
        name="Пункт"
        testId={DEFAULT_TEST_ID}
        canAddMore={false}
      />
    </div>
  </div>
</StorybookPage>
