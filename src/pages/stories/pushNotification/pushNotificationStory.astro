---
import { DEFAULT_TEST_ID } from "../../../../features/testIds";
import {
  PushNotification,
  PushNotificationTheme,
} from "../../../components/pushNotification/pushNotification.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";
---

<StorybookPage title="PushNotification">
  <div class="demoThemeWrapper">
    <h3 class="demoThemeWrapper__title">Without Themes</h3>
    <div class="grid grid_1Col">
      <span class="chead"></span>
      <span class="chead">Default</span>

      <span class="rhead">Universal</span>

      <PushNotification
        client:only="solid-js"
        isOpen={true}
        title="Заголовок"
        description="Описание"
        theme={PushNotificationTheme.Dangerous}
        onCloseNotification={() => {}}
        image="https://via.placeholder.com/150"
        testId={DEFAULT_TEST_ID}
      />
    </div>
  </div>
</StorybookPage>
