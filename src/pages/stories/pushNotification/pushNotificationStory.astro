---
import { DEFAULT_TEST_ID } from "../../../../features/testIds";
import { IconName } from "../../../components/icon/icon";
import {
  PushNotification,
  PushNotificationSize,
  PushNotificationTheme,
} from "../../../components/pushNotification/pushNotification.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(PushNotificationTheme);
const sizes = Object.values(PushNotificationSize);
---

<StorybookPage title="Push Notification">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_1Col">
          <span class="chead" />
          <span class="chead">Default</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>

              <PushNotification
                client:only="solid-js"
                title="Ошибка"
                iconName={IconName.GlobeSimpleX}
                description="Нет соединения с сервером"
                theme={PushNotificationTheme.Dangerous}
                onClose={() => {}}
                testId={DEFAULT_TEST_ID}
              />
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
