---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import { InputType } from "../../../components/input/input.tsx";
import {
  Input,
  InputSize,
  InputTheme,
} from "../../../components/input/input.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(InputTheme);
const sizes = Object.values(InputSize);

const PLACEHOLDER_TEXT = "Enter text...";
---

<StorybookPage title="Input">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_4Col">
          <span class="chead" />
          <span class="chead">Default</span>
          <span class="chead">Error</span>
          <span class="chead">Error Typed</span>
          <span class="chead">Disabled</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <Input
                client:only="solid-js"
                type={InputType.Text}
                theme={theme}
                size={size}
                placeholder={PLACEHOLDER_TEXT}
                maxLength={10}
                isRequired={true}
                name="Some-text"
                testId={DEFAULT_TEST_ID}
                label="Test"
                isClearable={true}
                isCountable={true}
              />
              <Input
                client:only="solid-js"
                type={InputType.Text}
                theme={theme}
                size={size}
                isError={true}
                placeholder={PLACEHOLDER_TEXT}
                maxLength={10}
                name="Some-text"
                isRequired={true}
                testId={DEFAULT_TEST_ID}
                label="Test"
                isClearable={true}
              />
              <Input
                client:only="solid-js"
                type={InputType.Text}
                theme={theme}
                size={size}
                isError={true}
                placeholder={PLACEHOLDER_TEXT}
                maxLength={10}
                name="Some-text"
                isRequired={true}
                defaultValue={"Text"}
                testId={DEFAULT_TEST_ID}
                label="Test"
                isClearable={true}
              />
              <Input
                client:only="solid-js"
                type={InputType.Text}
                theme={theme}
                size={size}
                isDisabled={true}
                placeholder={PLACEHOLDER_TEXT}
                maxLength={10}
                name="Some-text"
                isRequired={true}
                testId={DEFAULT_TEST_ID}
                label="Test"
                isClearable={true}
              />
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
