---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import { Button, ButtonComponentType, ButtonSize, ButtonTheme } from "../../../components/button/button.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(ButtonTheme);
const sizes = Object.values(ButtonSize);
---

<StorybookPage title="Button">
  <h2>Type - Button</h2>
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_3Col">
          <span class="chead" />
          <span class="chead">Default</span>
          <span class="chead">Loading</span>
          <span class="chead">Disabled</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <Button client:only="solid-js" theme={theme} size={size} testId={DEFAULT_TEST_ID}>
                Text
              </Button>
              <Button client:only="solid-js" theme={theme} size={size} testId={DEFAULT_TEST_ID} loading={true}>
                Text
              </Button>
              <Button client:only="solid-js" theme={theme} size={size} testId={DEFAULT_TEST_ID} disabled={true}>
                Text
              </Button>
            </>
          ))}
        </div>
      </div>
    ))
  }

  <h2>Type - Link</h2>
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_3Col">
          <span class="chead" />
          <span class="chead">Default</span>
          <span class="chead">Loading</span>
          <span class="chead">Disabled</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>
              <Button
                client:only="solid-js"
                componentType={ButtonComponentType.Link}
                theme={theme}
                size={size}
                testId={DEFAULT_TEST_ID}
              >
                Text
              </Button>
              <span>Не предусмотрено</span>
              <Button
                client:only="solid-js"
                componentType={ButtonComponentType.Link}
                theme={theme}
                size={size}
                testId={DEFAULT_TEST_ID}
                disabled={true}
              >
                Text
              </Button>
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
