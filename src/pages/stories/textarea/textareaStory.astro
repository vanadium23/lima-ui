---
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";
import {
  Textarea,
  TextareaTheme,
  TextareaSize,
} from "../../../components/textarea/textarea";

const themes = Object.values(TextareaTheme);
const sizes = Object.values(TextareaSize);

const PLACEHOLDER_TEXT = "Enter text...";
---

<StorybookPage title="Textarea">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 style="font-size: 24px; margin-bottom: 10px; text-transform: capitalize;">
          {theme}
        </h3>
        <div class="grid grid_4Col">
          <span class="chead" />
          <span class="chead">Default</span>
          <span class="chead">Error</span>
          <span class="chead">Error Typed</span>
          <span class="chead">Disabled</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>

              <Textarea
                client:only="solid-js"
                theme={theme}
                size={size}
                placeholder={PLACEHOLDER_TEXT}
                maxLength={500}
                isRequired={true}
                name="Some-text"
              />
              <Textarea
                client:only="solid-js"
                theme={theme}
                size={size}
                isError={true}
                placeholder={PLACEHOLDER_TEXT}
                maxLength={500}
                name="Some-text"
                isRequired={true}
              />
              <Textarea
                client:only="solid-js"
                theme={theme}
                size={size}
                isError={true}
                placeholder={PLACEHOLDER_TEXT}
                maxLength={500}
                name="Some-text"
                isRequired={true}
                defaultValue={"Text"}
              />
              <Textarea
                client:only="solid-js"
                theme={theme}
                size={size}
                isDisabled={true}
                placeholder={PLACEHOLDER_TEXT}
                maxLength={500}
                name="Some-text"
                isRequired={true}
              />
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
