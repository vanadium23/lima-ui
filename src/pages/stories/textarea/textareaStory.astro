---
import { DEFAULT_TEST_ID } from "../../../../features/testIds.ts";
import { Textarea, TextareaSize, TextareaTheme } from "../../../components/textarea/textarea.tsx";
import StorybookPage from "../../../layouts/storybook/storybookPage.astro";

const themes = Object.values(TextareaTheme);
const sizes = Object.values(TextareaSize);

const PLACEHOLDER_TEXT = "Enter text...";
---

<StorybookPage title="Textarea">
  {
    themes.map((theme) => (
      <div class="demoThemeWrapper">
        <h3 class="demoThemeWrapper__title">{theme}</h3>
        <div class="grid grid_4Col">
          <span class="chead" />
          <span class="chead">Default</span>
          <span class="chead">Error</span>
          <span class="chead">Error Typed</span>
          <span class="chead">Disabled</span>

          {sizes.map((size) => (
            <>
              <span class="rhead">{size}</span>

              <Textarea
                client:only="solid-js"
                theme={theme}
                size={size}
                placeholder={PLACEHOLDER_TEXT}
                maxLength={500}
                required={true}
                name="Some-text"
                testId={DEFAULT_TEST_ID}
              />
              <Textarea
                client:only="solid-js"
                theme={theme}
                size={size}
                error={true}
                placeholder={PLACEHOLDER_TEXT}
                maxLength={500}
                name="Some-text"
                required={true}
                testId={DEFAULT_TEST_ID}
              />
              <Textarea
                client:only="solid-js"
                theme={theme}
                size={size}
                error={true}
                placeholder={PLACEHOLDER_TEXT}
                maxLength={500}
                name="Some-text"
                required={true}
                testId={DEFAULT_TEST_ID}
              >
                Text
              </Textarea>
              <Textarea
                client:only="solid-js"
                theme={theme}
                size={size}
                disabled={true}
                placeholder={PLACEHOLDER_TEXT}
                maxLength={500}
                name="Some-text"
                required={true}
                testId={DEFAULT_TEST_ID}
              />
            </>
          ))}
        </div>
      </div>
    ))
  }
</StorybookPage>
