---
import { BACKEND_URL_AUTH_VERIFY_EMAIL } from "../../../utilities/addresses.ts";
import { setSessionCookie } from "../../../utilities/setSessionCookie.ts";
import Page from "../../layouts/page/page.astro";
import { Auth } from "../../widgets/auth/auth.tsx";

const verifyToken = Astro.url.searchParams.get("token");

if (verifyToken) {
  const response = await fetch(`${import.meta.env.SERVER_API_URL}${BACKEND_URL_AUTH_VERIFY_EMAIL}`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ token: verifyToken }),
  });

  if (response.ok) {
    const { token: authToken } = await response.json();

    setSessionCookie(Astro.cookies, authToken);

    return Astro.redirect("/lists", 302);
  }

  return Astro.redirect("/expiredLink", 302);
}
---

<Page titleName="Регистрация">
  <Auth client:only="solid-js" slot="mainContent" />
</Page>
