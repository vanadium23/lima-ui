    <meta content="width=device-width, initial-scale=1.0"
          name="viewport">
    <meta content="#ffffff" name="msapplication-TileColor">
    <meta content="img/favicon/ms-icon-144x144.png" name="msapplication-TileImage">
    <meta content="#ffffff" name="theme-color">
    <title>Svernik Storybook</title>
</head>
<body>

<header/>

<div class="wrapper">

    <aside class="sidebar">
        <h1 hidden>Svernik</h1>
        <div class="logo"></div>
        <div class="sidebar__navWrapper">
            <div class="sidebar__nav">
                <a class="sidebar__navItem" href="/stories/basicInput/basicInput/">Input</a>
                <a class="sidebar__navItem" href="/stories/button/button/">Button</a>
                <a class="sidebar__navItem" href="/stories/icon/icon/">Icon</a>
                <a class="sidebar__navItem" href="/stories/iconButton/iconButton/">Icon Button</a>
            </div>
