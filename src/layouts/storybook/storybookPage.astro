---
import "normalize.css";
import "./storybookPage.css";
import "../main.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="#ffffff" name="msapplication-TileColor" />
    <meta
      content="img/favicon/ms-icon-144x144.png"
      name="msapplication-TileImage"
    />
    <meta content="#ffffff" name="theme-color" />
    <title>Svernik - {title}</title>
  </head>
  <body>
    <header></header>

    <div class="wrapper">
      <aside class="sidebar">
        <h1 hidden>Svernik</h1>
        <div class="logo"></div>
        <div class="sidebar__navWrapper">
          <div class="sidebar__nav">
            <span class="sidebar__sectionTitle">Pages</span>
            <a class="sidebar__navItem" href="/create-checklist/"
              >Create checklist</a
            >
            <span class="sidebar__sectionTitle">Components</span>
            <a
              class="sidebar__navItem"
              href="/stories/basicInput/basicInputStory/">Input</a
            >
            <a class="sidebar__navItem" href="/stories/button/buttonStory/"
              >Button</a
            >
            <a class="sidebar__navItem" href="/stories/icon/iconStory/">Icon</a>
            <a
              class="sidebar__navItem"
              href="/stories/iconButton/iconButtonStory/">Icon Button</a
            >
            <a
              class="sidebar__navItem"
              href="/stories/removeIconButton/removeIconButtonStory/"
              >Remove Icon Button</a
            >
            <a
              class="sidebar__navItem"
              href="/stories/accordion/accordionStory/">Accordion</a
            >
            <a class="sidebar__navItem" href="/stories/textarea/textareaStory/"
              >Textarea</a
            >
            <a
              class="sidebar__navItem"
              href="/stories/charCounter/charCounterStory/">Char Counter</a
            >
            <a
              class="sidebar__navItem"
              href="/stories/pasteContent/pasteContentStory/">Paste Content</a
            >
            <a class="sidebar__navItem" href="/stories/note/noteStory/">Note</a>
          </div>
        </div>
      </aside>

      <main class="main">
        <div class="main__wrapper">
          <section class="component">
            <h2 id="main-button-link">{title}</h2>

            <slot />
          </section>
        </div>
      </main>
    </div>

    <footer></footer>
  </body>
</html>
