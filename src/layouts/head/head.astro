---
import { DEFAULT_TAB_TITLE, suffixTabTitle } from "../../../utilities/tabTitle.ts";

interface Props {
  titleName: string;
}

const { titleName } = Astro.props as Props;
---

<head>
  <meta charset="UTF-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <meta content="#ffffff" name="msapplication-TileColor" />
  <meta content="img/favicon/ms-icon-144x144.png" name="msapplication-TileImage" />
  <meta content="#ffffff" name="theme-color" />

  <!--
Ensures no FOUT (Flash of Unstyled Text).
Font changes also influence how our stretching text areas are initially drawn.
-->
  <link
    rel="preload"
    href="/fonts/montserrat/files/montserrat-normal-cyrillic.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link
    rel="preload"
    href="/fonts/montserrat/files/montserrat-normal-cyrillic-ext.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link
    rel="preload"
    href="/fonts/montserrat/files/montserrat-normal-latin.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link
    rel="preload"
    href="/fonts/montserrat/files/montserrat-normal-latin-ext.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />

  <title>
    {titleName ? `${suffixTabTitle(titleName)}` : DEFAULT_TAB_TITLE}
  </title>
</head>
