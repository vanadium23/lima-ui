---
import { PushNotificationWrapper } from "../../components/pushNotificationWrapper/pushNotificationWrapper.tsx";
import { Header } from "../../organisms/header/header.tsx";
import { Sidebar } from "../../organisms/sidebar/sidebar.tsx";
import Head from "../head/head.astro";

import "normalize.css";
import "../main.css";
import "./app.css";

interface Props {
  titleName: string;
  list404?: boolean;
}

const { titleName, list404 = false } = Astro.props as Props;
---

<!doctype html>
<html lang="ru">
  <Head titleName={titleName} />
  <body>
    <Header client:only="solid-js" list404={list404} />

    <div class="appContainer">
      <aside class="appContainer__nav">
        <Sidebar client:only="solid-js" />
      </aside>

      <main class="main">
        <slot name="mainContent" />
      </main>

      <PushNotificationWrapper client:only="solid-js" />
    </div>

    <footer></footer>
  </body>
</html>
