---
import { PushNotificationBar } from "../../components/pushNotificationWrapper/pushNotificationBar.tsx";
import { Header } from "../../organisms/header/header.tsx";
import { Sidebar } from "../../organisms/sidebar/sidebar.tsx";
import Head from "../head/head.astro";

import "normalize.css";
import "../main.css";
import "./app.css";

interface Props {
  titleName: string;
  list404?: boolean;
  isListsLimitReached: boolean;
}

const { titleName, list404 = false, isListsLimitReached } = Astro.props as Props;
---

<!doctype html>
<html lang="ru">
  <Head titleName={titleName} />
  <body>
    <Header client:only="solid-js" list404={list404} isListsLimitReached={isListsLimitReached} />

    <div class="appContainer">
      <aside class="appContainer__nav">
        <Sidebar client:only="solid-js" isListsLimitReached={isListsLimitReached} />
      </aside>

      <main class="main">
        <!-- TODO я бы провел рефакторинг небольшой и добавил сюда(или отдельный универсальный шаболоне)
         Title чтобы он всегда был, так как мы его вставляем каждый раз на странице Всех списков,
         на странице Создания списка, в Личном кабинете, на странице Тарифов.
         И мы каждый раз дублируем падинги Тайтла не контролируя все в одном месте.
         А так же скролл затащить сюда сразу.-->
        <slot name="mainContent" />
      </main>

      <PushNotificationBar client:only="solid-js" />
    </div>

    <footer></footer>
  </body>
</html>
